{
  "config": {
    "step": {
      "user": {
        "title": "Connect to ShieldDNS",
        "description": "If you need help, the documentation is at {docs_url}",
        "data": {
          "host": "Host/IP Address",
          "port": "Port",
          "token": "API Token",
          "use_ssl": "Use HTTPS (SSL/TLS)",
          "verify_ssl": "Verify SSL Certificate"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid authentication",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "Device is already configured"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Configure ShieldDNS",
        "data": {
          "token": "API Token",
          "update_interval": "Update Interval (minutes)"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "total_queries": {
        "name": "Total Queries Today"
      },
      "blocked_queries": {
        "name": "Blocked Queries Today"
      },
      "block_percentage": {
        "name": "Block Percentage"
      },
      "unique_clients": {
        "name": "Unique Clients"
      },
      "avg_response_time": {
        "name": "Avg. Response Time"
      },
      "cache_hit_ratio": {
        "name": "Cache Hit Ratio"
      },
      "db_size": {
        "name": "Database Size"
      },
      "ram_usage": {
        "name": "Memory Usage"
      },
      "cpu_usage": {
        "name": "CPU Load (1m)"
      },
      "auto_blocked_count": {
        "name": "Auto-Blocked Clients"
      },
      "connected_clients": {
        "name": "Connected Clients"
      },
      "active_qps": {
        "name": "Current QPS"
      },
      "uptime": {
        "name": "System Uptime"
      },
      "blocked_domains": {
        "name": "Blocked Domains (Total)"
      }
    },
    "binary_sensor": {
      "abuse_protection_enabled": {
        "name": "Abuse Protection Enabled"
      },
      "abuse_detected": {
        "name": "Abuse Detected"
      },
      "dns_health": {
        "name": "DNS Server Health"
      }
    },
    "switch": {
      "global_filtering": {
        "name": "Global Filtering"
      }
    },
    "button": {
      "refresh_lists": {
        "name": "Refresh Blocklists"
      },
      "reload_filters": {
        "name": "Reload Filters & DNS"
      },
      "clear_logs": {
        "name": "Clear Query Logs"
      },
      "recheck_upstreams": {
        "name": "Recheck Upstreams"
      }
    },
    "update": {
      "shielddns_update": {
        "name": "ShieldDNS Update"
      }
    }
  },
  "services": {
    "block_domain": {
      "name": "Block Domain",
      "description": "Instantly adds a domain to the ShieldDNS blocklist.",
      "fields": {
        "domain": {
          "name": "Domain",
          "description": "The domain to block (e.g., tiktok.com)."
        }
      }
    },
    "allow_domain": {
      "name": "Allow Domain",
      "description": "Instantly adds a domain to the ShieldDNS allowlist (whitelist).",
      "fields": {
        "domain": {
          "name": "Domain",
          "description": "The domain to allow (e.g., netflix.com)."
        }
      }
    },
    "remove_rule": {
      "name": "Remove Domain Rule",
      "description": "Removes a domain from both the blocklist and allowlist.",
      "fields": {
        "domain": {
          "name": "Domain",
          "description": "The domain to remove (e.g., tiktok.com)."
        }
      }
    },
    "set_client_alias": {
      "name": "Set Client Alias",
      "description": "Set a friendly name (alias) for a specific client IP address.",
      "fields": {
        "ip": {
          "name": "Client IP",
          "description": "The IP address of the client (e.g., 192.168.1.50)."
        },
        "alias": {
          "name": "Alias",
          "description": "The friendly name to assign (leave empty to remove)."
        }
      }
    },
    "block_client": {
      "name": "Block/Unblock Client",
      "description": "Toggles blocking for a specific client device by its IP.",
      "fields": {
        "ip": {
          "name": "Client IP",
          "description": "The IP address of the client to manage."
        },
        "block": {
          "name": "Block",
          "description": "Set to ON to block, OFF to unblock."
        }
      }
    }
  }
}
